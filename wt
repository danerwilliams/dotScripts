#!/bin/bash

# wt - Create or delete a worktree branch
# Usage:
#   wt branch-name        - Create new worktree branch and open in Warp with 3-pane layout
#   wt delete branch-name - Delete worktree and its branch

set -e  # Exit on error

# Check if arguments are provided
if [ $# -eq 0 ]; then
    echo "Usage:"
    echo "  wt branch-name        - Create new worktree branch"
    echo "  wt delete branch-name - Delete worktree and branch"
    exit 1
fi

# Handle --help flag
if [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    echo "Usage:"
    echo "  wt branch-name        - Create new worktree branch"
    echo "  wt delete branch-name - Delete worktree and branch"
    echo ""
    echo "Initialization:"
    echo "  If .initialize-worktree.sh exists in the primary worktree root,"
    echo "  it will be executed after creating the new worktree."
    exit 0
fi

# Handle delete command
if [ "$1" = "delete" ]; then
    if [ $# -lt 2 ]; then
        echo "Usage: wt delete branch-name"
        exit 1
    fi

    BRANCH_NAME="$2"

    # Get the repository root
    if ! git rev-parse --git-dir > /dev/null 2>&1; then
        echo "Error: Not in a git repository"
        exit 1
    fi

    REPO_ROOT=$(git rev-parse --show-toplevel)
    WORKTREE_BASE=$(dirname "$REPO_ROOT")
    WORKTREE_PATH="$WORKTREE_BASE/$BRANCH_NAME"

    # Check if worktree exists
    if [ ! -d "$WORKTREE_PATH" ]; then
        echo "Error: Worktree not found at $WORKTREE_PATH"
        exit 1
    fi

    # Remove worktree
    echo "Removing worktree at $WORKTREE_PATH..."
    git worktree remove "$WORKTREE_PATH"

    # Delete branch
    echo "Deleting branch '$BRANCH_NAME'..."
    git branch -D "$BRANCH_NAME"

    echo "Successfully deleted worktree and branch '$BRANCH_NAME'"
    exit 0
fi

# Otherwise, create new worktree
BRANCH_NAME="$1"

# Check if we're in a git repository
if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "Error: Not in a git repository"
    exit 1
fi

# Get the repository root
REPO_ROOT=$(git rev-parse --show-toplevel)

# Worktrees go in the parent directory of the current repo/worktree
WORKTREE_BASE=$(dirname "$REPO_ROOT")
WORKTREE_PATH="$WORKTREE_BASE/$BRANCH_NAME"

# Check if worktree already exists
if [ -d "$WORKTREE_PATH" ]; then
    echo "Worktree already exists at $WORKTREE_PATH"
else
    # Create worktree base directory if needed
    mkdir -p "$WORKTREE_BASE"

    # Check if branch already exists
    if git show-ref --verify --quiet "refs/heads/$BRANCH_NAME"; then
        # Create worktree for existing branch
        echo "Branch '$BRANCH_NAME' exists. Creating worktree at $WORKTREE_PATH..."
        git worktree add "$WORKTREE_PATH" "$BRANCH_NAME"
    else
        # Create the new branch and worktree
        echo "Creating worktree at $WORKTREE_PATH..."
        git worktree add -b "$BRANCH_NAME" "$WORKTREE_PATH"

        # Track with Graphite if available (only for new branches)
        if command -v gt &> /dev/null; then
            (cd "$WORKTREE_PATH" && gt branch track 2>/dev/null && echo "Branch tracked in Graphite")
        fi
    fi

    # Run initialization script if it exists
    INIT_SCRIPT="$WORKTREE_BASE/$(basename "$REPO_ROOT")/.initialize-worktree.sh"
    if [ -f "$INIT_SCRIPT" ]; then
        echo "Running initialization script..."
        (cd "$WORKTREE_PATH" && bash "$INIT_SCRIPT")
    fi
fi

# Open new Warp tab with the worktree directory
open "warp://action/new_tab?path=$WORKTREE_PATH"

# Wait for the tab to open
sleep 1

# Create 3-pane layout using keyboard shortcuts
# Delays are needed to ensure Warp fully processes each split command before the next keystroke
osascript <<EOF
tell application "System Events"
    -- Split vertically to create left and right panes (Cmd+D)
    keystroke "d" using command down
    delay 0.2

    -- Split the right pane horizontally (Cmd+Shift+D)
    keystroke "d" using {command down, shift down}
    delay 0.2

    -- Return to first (left) pane - need two movements since focus is on top-right
    keystroke "[" using command down
    delay 0.1
    keystroke "[" using command down
end tell
EOF

echo "Created branch '$BRANCH_NAME' at $WORKTREE_PATH with 3-pane layout"
